<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.kaiser.codex-bridge</string>

  <key>ProgramArguments</key>
  <array>
    <string>/bin/zsh</string>
    <string>-lc</string>
    <string>exec /Users/kaiser/workspace/codex-workspace/codex-bridge/scripts/run-codex-bridge.sh</string>
  </array>

  <key>WorkingDirectory</key>
  <string>/Users/kaiser/workspace/codex-workspace/codex-bridge</string>

  <key>RunAtLoad</key>
  <true/>

  <key>KeepAlive</key>
  <dict>
    <key>SuccessfulExit</key>
    <false/>
  </dict>

  <key>StandardOutPath</key>
  <string>/Users/kaiser/Library/Logs/codex-bridge/stdout.log</string>

  <key>StandardErrorPath</key>
  <string>/Users/kaiser/Library/Logs/codex-bridge/stderr.log</string>
</dict>
</plist>
